<Project Sdk="Microsoft.NET.Sdk">
  <!-- Client wave 8 (w8core): Horde's engine, content and wire, the Loki client's own pure-C# files (links across the repo,
       as PresenceWire.cs is for Core): Loki Host runs the simulation with the very code the client compiles.
       netstandard2.1 + C# 9 on purpose: what Unity 2022.3 compiles. If this project builds, the files build in Unity too
       (no UnityEngine, no newer language or library feature). Moving the folder breaks this build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Loki.Horde</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Horde\Core\**\*.cs" Link="Horde\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Net\IHordeChannel.cs" Link="Net\IHordeChannel.cs" />
  </ItemGroup>
</Project>
