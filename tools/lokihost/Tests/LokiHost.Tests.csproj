<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\LokiHost.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- client wave 6 (w6voice): the client's own voice code without a Unity dependency (codec, noise gate, jitter buffer,
         resampler), compiled here so its unit tests run with the relay's (VoiceTests.cs); the relay itself never decodes voice -->
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Voice\ImaAdpcm.cs" Link="Voice\ImaAdpcm.cs" />
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Voice\VoiceGate.cs" Link="Voice\VoiceGate.cs" />
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Voice\VoiceStream.cs" Link="Voice\VoiceStream.cs" />
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Voice\VoiceResampler.cs" Link="Voice\VoiceResampler.cs" />
    <!-- client wave 18 (w18acct): the client's rule of which save wins (settings per account), tested with the relay's side -->
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\World\AccountSyncRules.cs" Link="World\AccountSyncRules.cs" />
    <!-- wave 28 (wcxp): the Codex bounties' words and the client's state of them (no Unity in either), tested against the script Loki Host installs -->
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Net\CodexBountyWire.cs" Link="Net\CodexBountyWire.cs" />
    <Compile Include="..\..\..\client\Assets\Loki\Runtime\Game\CodexBounty.cs" Link="Game\CodexBounty.cs" />
  </ItemGroup>
</Project>
